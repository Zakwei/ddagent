{
  "name": "@ddagent-ai/ddagent",
  "version": "0.8.17",
  "productName": "DDAgent",
  "description": "Self-hosted server and Flutter client (web, Linux, Windows, Android) for AI coding agents (Claude Code, Codex, Cursor CLI, OpenCode, Devin, Command Code, Antigravity)",
  "type": "module",
  "main": "dist-server/server/index.js",
  "bin": {
    "ddagent": "dist-server/server/modules/cli/cli.js"
  },
  "files": [
    "server/",
    "shared/",
    "public/api-docs.html",
    "dist-server/",
    "scripts/",
    "README.md"
  ],
  "homepage": "https://github.com/Zakwei/ddagent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zakwei/ddagent.git"
  },
  "bugs": {
    "url": "https://github.com/Zakwei/ddagent/issues"
  },
  "scripts": {
    "dev": "npm run server:dev",
    "preserver": "node scripts/promote-dist-server.mjs recover",
    "server": "cross-env VITE_IS_PLATFORM=true SERVER_PORT=10087 node dist-server/server/index.js",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:dev-watch": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "release": "node scripts/release/bump-version.mjs",
    "licenses:generate": "node scripts/release/generate-third-party-notices.mjs",
    "server:bundle": "npm run build && node scripts/release/build-server-bundle.js",
    "build": "npm run build:server",
    "prebuild:server": "node -e \"require('node:fs').rmSync('dist-server.next', { recursive: true, force: true })\"",
    "build:server": "tsc -p server/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "postbuild:server": "node scripts/promote-dist-server.mjs",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --tsconfig server/tsconfig.json --test \"server/**/*.test.ts\" \"server/**/*.test.js\"",
    "lint": "eslint server/",
    "lint:fix": "eslint server/ --fix",
    "start": "npm run build && npm run server",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "keywords": [
    "claude code",
    "claude-code",
    "ddagent",
    "ddagent",
    "codex",
    "cursor",
    "cursor-cli",
    "anthropic",
    "openai",
    "google",
    "coding-agent",
    "web-ui",
    "ui",
    "flutter"
  ],
  "author": "DDNet <kontakt@ddnet.com.pl>",
  "license": "AGPL-3.0-only",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.165",
    "@iarna/toml": "^2.2.5",
    "@octokit/rest": "^22.0.0",
    "@openai/codex-sdk": "^0.160.0",
    "@vscode/ripgrep": "^1.17.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "msedge-tts": "^2.0.7",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.2.0-beta.12",
    "web-push": "^3.6.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.7",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "node-gyp": "^10.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "lint-staged": {
    "server/**/*.{js,ts}": "eslint"
  }
}
