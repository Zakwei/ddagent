{
  "name": "@ddagent-ai/ddagent",
  "version": "0.7.0",
  "productName": "ddagent",
  "description": "Self-hosted web & mobile UI for AI coding agents (Claude Code, Codex, Cursor CLI, OpenCode, Devin)",
  "type": "module",
  "main": "dist-server/server/index.js",
  "bin": {
    "ddagent": "dist-server/server/modules/cli/cli.js"
  },
  "files": [
    "electron/",
    "server/",
    "shared/",
    "public/api-docs.html",
    "dist/",
    "dist-server/",
    "scripts/",
    "README.md"
  ],
  "homepage": "https://github.com/Zakwei/ddagent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zakwei/ddagent.git"
  },
  "bugs": {
    "url": "https://github.com/Zakwei/ddagent/issues"
  },
  "scripts": {
    "dev": "npm run server:dev",
    "preserver": "node scripts/promote-dist-server.mjs recover",
    "server": "cross-env VITE_IS_PLATFORM=true SERVER_PORT=10087 node dist-server/server/index.js",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:dev-watch": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "desktop": "electron electron/main.js",
    "desktop:dev": "cross-env ELECTRON_DEV_URL=http://127.0.0.1:5173 electron electron/main.js",
    "desktop:stage": "node scripts/release/prepare-desktop-app.js",
    "desktop:pack": "npm run build && npm run desktop:stage && electron-builder --projectDir .desktop-build/desktop-app --dir",
    "desktop:dist:mac": "npm run build && npm run desktop:stage && electron-builder --projectDir .desktop-build/desktop-app --mac dmg",
    "desktop:dist:win": "npm run build && cross-env DDAGENT_DESKTOP_TARGET=win32 npm run desktop:stage && cross-env ELECTRON_BUILDER_WINE_TOOLSET_DIR=$HOME/.cache/ddagent-wine-toolset electron-builder --projectDir .desktop-build/desktop-app --win nsis",
    "desktop:dist:linux": "npm run build && npm run desktop:stage && electron-builder --projectDir .desktop-build/desktop-app --linux",
    "release:desktop": "node scripts/release/desktop-release.mjs",
    "licenses:generate": "node scripts/release/generate-third-party-notices.mjs",
    "server:bundle": "npm run build && node scripts/release/build-server-bundle.js",
    "desktop:icon:mac": "node electron/scripts/generate-macos-icon.js",
    "build": "npm run build:server",
    "prebuild:server": "node -e \"require('node:fs').rmSync('dist-server.next', { recursive: true, force: true })\"",
    "build:server": "tsc -p server/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "postbuild:server": "node scripts/promote-dist-server.mjs",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --tsconfig server/tsconfig.json --test \"server/**/*.test.ts\" \"server/**/*.test.js\"",
    "pretest:desktop": "node scripts/check-desktop-build.mjs",
    "test:desktop": "cross-env DDAGENT_DESKTOP_INPROC=1 DDAGENT_DESKTOP_NO_TRAY=1 electron --no-sandbox --ozone-platform=headless --disable-gpu electron/scripts/smoke-inproc-e2e.mjs",
    "test:desktop:remote": "cross-env DDAGENT_DESKTOP_INPROC=1 DDAGENT_DESKTOP_NO_TRAY=1 electron --no-sandbox --ozone-platform=headless --disable-gpu electron/scripts/smoke-remote-e2e.mjs",
    "lint": "eslint server/ mobile/src",
    "lint:fix": "eslint server/ mobile/src --fix",
    "mobile:dev": "npm --prefix mobile run start",
    "mobile:tunnel": "npm --prefix mobile run start -- --tunnel",
    "mobile:test": "npm --prefix mobile run test",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:build-apk": "npm --prefix mobile run apk",
    "mobile:build-aab": "npm --prefix mobile run build:release",
    "mobile:update": "npm --prefix mobile exec -- eas-cli update --auto",
    "start": "npm run build && npm run server",
    "release": "./release.sh",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "build": {
    "appId": "ai.ddagent.desktop",
    "productName": "ddagent",
    "asar": false,
    "artifactName": "ddagent-desktop-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release/desktop"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "electron/",
      "public/",
      "dist/",
      "dist-server/",
      "shared/",
      "server/",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-{darwin,linux,win32}-*/**"
    ],
    "protocols": [
      {
        "name": "ddagent",
        "schemes": [
          "ddagent"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "electron/assets/logo-macos.icns",
      "notarize": true,
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "CFBundleName": "ddagent",
        "CFBundleDisplayName": "ddagent",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "ddagent",
            "CFBundleURLSchemes": [
              "ddagent"
            ]
          }
        ]
      }
    },
    "win": {
      "icon": "electron/assets/logo-windows.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "electron/assets/logo-windows.ico",
      "uninstallerIcon": "electron/assets/logo-windows.ico"
    },
    "linux": {
      "category": "Development",
      "executableName": "ddagent",
      "syncDesktopName": true,
      "maintainer": "Zakwei <napek97@gmail.com>",
      "icon": "electron/assets/logo-linux.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "keywords": [
    "claude code",
    "claude-code",
    "ddagent",
    "ddagent",
    "codex",
    "cursor",
    "cursor-cli",
    "anthropic",
    "openai",
    "google",
    "coding-agent",
    "web-ui",
    "ui",
    "mobile IDE"
  ],
  "author": "DDNet <kontakt@ddnet.com.pl>",
  "license": "AGPL-3.0-only",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.165",
    "@iarna/toml": "^2.2.5",
    "@octokit/rest": "^22.0.0",
    "@openai/codex-sdk": "^0.146.0",
    "@vscode/ripgrep": "^1.17.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "msedge-tts": "^2.0.7",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.2.0-beta.12",
    "web-push": "^3.6.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.3",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.7",
    "@types/ws": "^8.18.1",
    "auto-changelog": "^2.5.0",
    "cross-env": "^10.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "node-gyp": "^10.0.0",
    "release-it": "^19.0.5",
    "sharp": "^0.34.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "lint-staged": {
    "server/**/*.{js,ts}": "eslint"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "screenshot-desktop": "^1.15.4"
  }
}
